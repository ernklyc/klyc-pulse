<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:Pulse.App">

    <!--
        KLYC-Pulse tasarım sistemi: kâğıt beyazı, mürekkep siyahı,
        ince çizgiler, gradyan ve gölge yok. Başlıkta Instrument Serif, gövdede Geist.
        Masaüstü uygulaması yoğunluğu: küçük boyutlar, sıkı boşluklar, belirgin düğmeler.
    -->

    <BooleanToVisibilityConverter x:Key="BoolToVis" />
    <local:InvertBoolConverter x:Key="InvertBool" />
    <local:NullToCollapsedConverter x:Key="NullToCollapsed" />
    <local:StringToVisibilityConverter x:Key="StringToVis" />
    <local:EqualsToVisibilityConverter x:Key="EqualsToVis" />
    <FontFamily x:Key="BodyFont">pack://application:,,,/Fonts/#Geist</FontFamily>
    <FontFamily x:Key="DisplayFont">pack://application:,,,/Fonts/#Instrument Serif</FontFamily>
    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <Color x:Key="PaperColor">#FFFFFF</Color>
    <Color x:Key="Paper2Color">#F1F2F4</Color>
    <Color x:Key="SurfaceColor">#FAFAFA</Color>
    <Color x:Key="InkColor">#111827</Color>
    <Color x:Key="LineColor">#E7E8EC</Color>
    <Color x:Key="LineStrongColor">#D1D5DB</Color>
    <Color x:Key="MutedColor">#525A68</Color>
    <Color x:Key="AccentGrayColor">#4B5563</Color>
    <Color x:Key="GoodColor">#0D6E35</Color>
    <Color x:Key="WarnColor">#B45309</Color>
    <Color x:Key="BadColor">#C4262E</Color>
    <Color x:Key="InfoColor">#1F4FD1</Color>

    <SolidColorBrush x:Key="PaperBrush" Color="{StaticResource PaperColor}" />
    <SolidColorBrush x:Key="Paper2Brush" Color="{StaticResource Paper2Color}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="InkBrush" Color="{StaticResource InkColor}" />
    <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
    <SolidColorBrush x:Key="LineStrongBrush" Color="{StaticResource LineStrongColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="AccentGrayBrush" Color="{StaticResource AccentGrayColor}" />
    <SolidColorBrush x:Key="GoodBrush" Color="{StaticResource GoodColor}" />
    <SolidColorBrush x:Key="WarnBrush" Color="{StaticResource WarnColor}" />
    <SolidColorBrush x:Key="BadBrush" Color="{StaticResource BadColor}" />
    <SolidColorBrush x:Key="InfoBrush" Color="{StaticResource InfoColor}" />

    <!-- Tipografi (masaüstü yoğunluğu) -->
    <Style x:Key="PulseLabel" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style x:Key="PulseDisplay" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="30" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="PulseLead" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontStyle" Value="Italic" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="PulseBody" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="PulseMuted" TargetType="TextBlock" BasedOn="{StaticResource PulseBody}">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
    </Style>
    <Style x:Key="PulseStat" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
    </Style>

    <Style x:Key="PulseHairline" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource LineBrush}" />
    </Style>
    <Style x:Key="PulseCard" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PaperBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="14" />
    </Style>
    <Style x:Key="PulseBadge" TargetType="Border">
        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="Margin" Value="0,0,5,0" />
        <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
    </Style>

    <!-- Birincil düğme: siyah dolgu, belirgin -->
    <Style x:Key="PulsePrimaryButton" TargetType="Button">
        <Setter Property="Height" Value="30" />
        <Setter Property="MinWidth" Value="76" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        <Setter Property="Background" Value="{StaticResource InkBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#374151" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#000000" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- İkincil düğme: gri dolgu + belirgin çerçeve -->
    <Style x:Key="PulseGhostButton" TargetType="Button" BasedOn="{StaticResource PulsePrimaryButton}">
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="Background" Value="{StaticResource Paper2Brush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" Background="{TemplateBinding Background}" BorderBrush="{StaticResource LineStrongBrush}" BorderThickness="1"
                            CornerRadius="5" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource InkBrush}" />
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource PaperBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="{StaticResource Paper2Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Aktif mod için etkisiz düğme görünümü -->
    <Style x:Key="PulseActiveButton" TargetType="Button" BasedOn="{StaticResource PulseGhostButton}">
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>


    <!-- Segment düğmesi (site: rounded-full border pill). Tag = sekme numarası, DataContext.Tab seçili sekmeyi tutar -->
    <Style x:Key="PulseSegment" TargetType="Button">
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontFamily" Value="{StaticResource BodyFont}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="Medium" />
        <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="15" BorderThickness="1" Padding="{TemplateBinding Padding}"
                            Background="{StaticResource PaperBrush}" BorderBrush="{StaticResource LineStrongBrush}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="BorderBrush" Value="{StaticResource InkBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PulseSegmentActive" TargetType="Button" BasedOn="{StaticResource PulseSegment}">
        <Setter Property="Foreground" Value="{StaticResource PaperBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="15" Background="{StaticResource InkBrush}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="PulseBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="3" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{StaticResource Paper2Brush}" CornerRadius="1.5" />
                        <Border x:Name="PART_Track" />
                        <Border x:Name="PART_Indicator" Background="{StaticResource InkBrush}" CornerRadius="1.5" HorizontalAlignment="Left" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
