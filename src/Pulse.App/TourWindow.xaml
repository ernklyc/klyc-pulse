<Window x:Class="Pulse.App.TourWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KLYC-Pulse'a hoş geldin" Width="660" Height="560" MinHeight="520"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource PaperBrush}" FontFamily="{StaticResource BodyFont}">
    <Grid Margin="30,24,30,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock x:Name="StepLabel" Style="{StaticResource PulseLabel}" />
            <TextBlock x:Name="TitleText" FontFamily="{StaticResource DisplayFont}" FontSize="34" Foreground="{StaticResource InkBrush}" Margin="0,4,0,0" TextWrapping="Wrap" />
            <Border Style="{StaticResource PulseHairline}" Margin="0,12,0,0" />
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,14,0,10">
            <StackPanel>
                <TextBlock x:Name="LeadText" Style="{StaticResource PulseLead}" TextWrapping="Wrap" />
                <ItemsControl x:Name="Bullets" Margin="0,10,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="●" FontSize="8" Foreground="{StaticResource AccentGrayBrush}" VerticalAlignment="Top" Margin="2,6,0,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{Binding Head}" Style="{StaticResource PulseBody}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Body}" Style="{StaticResource PulseMuted}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border x:Name="TipBox" Style="{StaticResource PulseCard}" Padding="14,10" Margin="0,6,0,0">
                    <TextBlock x:Name="TipText" Style="{StaticResource PulseBody}" TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <DockPanel Grid.Row="2">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="BackButton" Content="Geri" Style="{StaticResource PulseGhostButton}" Click="Back_Click" Margin="0,0,8,0" MinWidth="70" />
                <Button x:Name="GoButton" Style="{StaticResource PulseGhostButton}" Click="Go_Click" Margin="0,0,8,0" Visibility="Collapsed" />
                <Button x:Name="NextButton" Content="İleri" Style="{StaticResource PulsePrimaryButton}" Click="Next_Click" MinWidth="90" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="SkipButton" Content="Turu atla" Style="{StaticResource PulseGhostButton}" Click="Skip_Click" />
                <TextBlock x:Name="Dots" Style="{StaticResource PulseMuted}" VerticalAlignment="Center" Margin="14,0,0,0" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
