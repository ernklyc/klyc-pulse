<Page x:Class="Pulse.App.Pages.ToolsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:c="clr-namespace:Pulse.App.Controls"
      Background="Transparent" FontFamily="{StaticResource BodyFont}"
      ScrollViewer.CanContentScroll="False" ScrollViewer.VerticalScrollBarVisibility="Disabled">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,18,26,22" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource PulseLabel}" Text="ARAÇLAR" />
            <TextBlock Style="{StaticResource PulseDisplay}" Margin="0,2,0,0" Text="Hepsi tek yerden, birlikte." />
            <TextBlock Style="{StaticResource PulseLead}" Margin="0,2,0,0"
                       Text="Her etiket bir özelliğin nasıl yapıldığını söyler: VAR = Pulse kendisi yapıyor. ORTAK = Pulse diğer programı arka planda kullanarak yapıyor. Normalde hiçbirini açmana gerek yok, Pulse tek başına yeter. Diğer programları kapatırsan silinmez, geri açılır." />
            <Border Style="{StaticResource PulseHairline}" Margin="0,14,0,12" />

            <Border Style="{StaticResource PulseCard}" Padding="16,12" Margin="0,0,0,12">
                <StackPanel>
                    <TextBlock Text="Oyun modunu seçince ne olur?" FontFamily="{StaticResource DisplayFont}" FontSize="20" Foreground="{StaticResource InkBrush}" />
                    <TextBlock Style="{StaticResource PulseBody}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Pulse tek başına her şeyi yapar: ASUS Turbo profili, işlemci ek hızı, ekran hızı, parlaklık ve (istersen) ekran kartı hızlandırma. Her adımın tutup tutmadığını da kontrol eder." />
                    <TextBlock Style="{StaticResource PulseBody}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Aşağıdaki programlardan hiçbirini kendiliğinden açmaz. G-Helper, Afterburner ya da ThrottleStop yalnızca sen “birlikte aç” anahtarını açarsan ve bir mod için profil seçersen devreye girer. Bu bilgisayarda hiçbirine ihtiyacın yok: onların yapabildiği her şeyi Pulse zaten yapıyor, yapılamayanlar da (işlemci voltajı, fan hızı) o programlarla da yapılamıyor." />
                    <TextBlock Style="{StaticResource PulseMuted}" TextWrapping="Wrap" Margin="0,6,0,0"
                               Text="Bir program Pulse'ın ayarını bozarsa Pulse bunu dakikada bir kontrol eder ve geri düzeltir (Ayarlar > Başka programlarla çakışma)." />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource PulseCard}" Padding="16,12" Margin="0,0,0,10" Visibility="{Binding Op.IsActive, Converter={StaticResource BoolToVis}}">
                <c:BusyBar IsActive="{Binding Op.IsActive}" Fraction="{Binding Op.Fraction}" Text="{Binding Op.Text}" Counter="{Binding Op.Counter}" />
            </Border>
            <TextBlock Style="{StaticResource PulseMuted}" Text="{Binding Note}" Margin="0,0,0,8" TextWrapping="Wrap" FontWeight="Medium" />

            <ItemsControl ItemsSource="{Binding Tools}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource PulseCard}" Padding="0" Margin="0,0,0,12">
                            <StackPanel>
                                <Grid Margin="16,12,16,10">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Name}" FontFamily="{StaticResource DisplayFont}" FontSize="22" Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Text="{Binding What}" Style="{StaticResource PulseMuted}" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}" FontWeight="SemiBold" FontSize="12" Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding Detail}" Style="{StaticResource PulseMuted}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top"
                                                Visibility="{Binding IsInstalled, Converter={StaticResource BoolToVis}}">
                                        <Button Content="Geri al" Style="{StaticResource PulseGhostButton}" Margin="0,0,8,0" IsEnabled="{Binding HasBackup}"
                                                Command="{Binding DataContext.RevertCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                        <Button Content="Kapat" Style="{StaticResource PulseGhostButton}" IsEnabled="{Binding IsActive}"
                                                Command="{Binding DataContext.LeaveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </Grid>
                                <Border Style="{StaticResource PulseHairline}" />
                                <ItemsControl ItemsSource="{Binding Parity}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="16,6">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource PulseBadge}" HorizontalAlignment="Left" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Label}" Foreground="{Binding Brush}" FontSize="10.5" FontWeight="SemiBold" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding Text}" Style="{StaticResource PulseBody}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Visibility="{Binding HasLink, Converter={StaticResource BoolToVis}}">
                                    <Border Style="{StaticResource PulseHairline}" Margin="0,6,0,0" />
                                    <Grid Margin="16,10,16,4">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel Margin="0,0,16,0">
                                            <TextBlock Text="{Binding LinkTitle}" Style="{StaticResource PulseBody}" FontWeight="Medium" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding LinkHelp}" Style="{StaticResource PulseMuted}" TextWrapping="Wrap" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Content="{Binding OpenText}" Style="{StaticResource PulseGhostButton}" Margin="0,0,12,0" Height="28"
                                                    Visibility="{Binding CanOpen, Converter={StaticResource BoolToVis}}" Command="{Binding OpenCommand}" />
                                            <ui:ToggleSwitch IsChecked="{Binding Link.StartWithPulse}" />
                                        </StackPanel>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Link.Rows}" Margin="16,4,16,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="190" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Title}" Style="{StaticResource PulseBody}" VerticalAlignment="Center" />
                                                    <ComboBox Grid.Column="1" ItemsSource="{Binding Options}" SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}" HorizontalAlignment="Left" MinWidth="170" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="{Binding Link.Status}" Style="{StaticResource PulseMuted}" TextWrapping="Wrap" Margin="16,6,16,2" FontWeight="Medium"
                                               Visibility="{Binding Link.Status, Converter={StaticResource StringToVis}}" />
                                </StackPanel>                                <TextBlock Text="{Binding Caution}" Style="{StaticResource PulseMuted}" Foreground="{StaticResource WarnBrush}" TextWrapping="Wrap"
                                           Margin="16,2,16,12" Visibility="{Binding Caution, Converter={StaticResource StringToVis}}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</Page>