<Page x:Class="Pulse.App.Pages.ProcessesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:c="clr-namespace:Pulse.App.Controls"
      xmlns:vm="clr-namespace:Pulse.App.ViewModels"
      Background="Transparent" FontFamily="{StaticResource BodyFont}"
      ScrollViewer.CanContentScroll="False" ScrollViewer.VerticalScrollBarVisibility="Disabled">
    <Page.Resources>
        <DataTemplate x:Key="SortTemplate">
            <Grid Margin="0,0,6,0">
                <Button Content="{Binding Title}" Style="{StaticResource PulseSegment}" MinWidth="72"
                        Command="{Binding DataContext.SetSortCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                <Button Content="{Binding Title}" Style="{StaticResource PulseSegmentActive}" MinWidth="72"
                        Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                        Command="{Binding DataContext.SetSortCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,18,26,22" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource PulseLabel}" Text="SÜREÇLER" />
            <TextBlock Style="{StaticResource PulseDisplay}" Margin="0,2,0,0" Text="Kim ne kadar yiyor?" />
            <TextBlock Style="{StaticResource PulseLead}" Margin="0,2,0,0"
                       Text="Her programın ne kadar işlemci ve bellek yediği. İstediğini kapatabilir, önemini (öncelik) ayarlayabilir ya da “Eko” ile kısabilirsin. Windows'un kendi programları korumalıdır, onları kapatamazsın." />
            <Border Style="{StaticResource PulseHairline}" Margin="0,14,0,12" />

            <DockPanel Margin="0,0,0,8" LastChildFill="False">
                <ui:TextBox DockPanel.Dock="Left" PlaceholderText="Program ara…" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Width="240" />
                <ItemsControl DockPanel.Dock="Left" ItemsSource="{Binding SortChoices}" ItemTemplate="{StaticResource SortTemplate}" Margin="14,0,0,0" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                </ItemsControl>
                <ui:ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding ShowProtected}" Content="Korumalıları göster" FontSize="12" VerticalAlignment="Center" />
            </DockPanel>
            <TextBlock Style="{StaticResource PulseMuted}" Text="{Binding Summary}" Margin="0,0,0,2" />
            <TextBlock Style="{StaticResource PulseMuted}" Text="{Binding Status}" Margin="0,0,0,8" FontWeight="Medium" />
            <Border Style="{StaticResource PulseCard}" Padding="16,12" Margin="0,0,0,8" Visibility="{Binding Op.IsActive, Converter={StaticResource BoolToVis}}">
                <c:BusyBar IsActive="{Binding Op.IsActive}" Fraction="{Binding Op.Fraction}" Text="{Binding Op.Text}" Counter="{Binding Op.Counter}" />
            </Border>

            <Border Style="{StaticResource PulseCard}" Padding="0">
                <ItemsControl ItemsSource="{Binding View}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid Margin="14,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="78" />
                                        <ColumnDefinition Width="118" />
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource PulseBody}" FontWeight="Medium" />
                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource PulseMuted}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            <Border Style="{StaticResource PulseBadge}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding IsProtected, Converter={StaticResource BoolToVis}}">
                                                <TextBlock Text="KORUMALI" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource GoodBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Title}" Style="{StaticResource PulseMuted}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding CpuText}" Style="{StaticResource PulseBody}" TextAlignment="Right" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding MemoryText}" Style="{StaticResource PulseBody}" TextAlignment="Right" VerticalAlignment="Center" />
                                    <ComboBox Grid.Column="3" Margin="12,0,0,0" ItemsSource="{x:Static vm:ProcRowVm.Priorities}" SelectedIndex="{Binding PriorityIndex, Mode=TwoWay}"
                                              IsEnabled="{Binding IsProtected, Converter={StaticResource InvertBool}}" VerticalAlignment="Center" />
                                    <StackPanel Grid.Column="4" Margin="12,0,0,0" VerticalAlignment="Center" Orientation="Horizontal"
                                                IsEnabled="{Binding IsProtected, Converter={StaticResource InvertBool}}" ToolTip="Eko: programı kısar. Bilgisayar daha az ısınır, fan daha az ses çıkarır.">
                                        <ui:ToggleSwitch IsChecked="{Binding EcoMode}" />
                                        <TextBlock Text="Eko" Style="{StaticResource PulseMuted}" VerticalAlignment="Center" Margin="2,0,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="5" Content="Kapat" Style="{StaticResource PulseGhostButton}" Margin="10,0,0,0" Height="26" MinWidth="64" VerticalAlignment="Center"
                                            IsEnabled="{Binding IsProtected, Converter={StaticResource InvertBool}}"
                                            Command="{Binding DataContext.CloseCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                </Grid>
                                <Border Style="{StaticResource PulseHairline}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>