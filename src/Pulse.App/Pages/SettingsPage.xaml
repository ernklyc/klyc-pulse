<Page x:Class="Pulse.App.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Background="Transparent" FontFamily="{StaticResource BodyFont}"
      ScrollViewer.CanContentScroll="False" ScrollViewer.VerticalScrollBarVisibility="Disabled">
    <Page.Resources>
        <!-- Ayar satırı: başlık + açıklama solda, anahtar sağda -->
        <Style x:Key="SettingTitle" TargetType="TextBlock" BasedOn="{StaticResource PulseBody}">
            <Setter Property="FontWeight" Value="Medium" />
        </Style>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,18,26,22" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource PulseLabel}" Text="AYARLAR" />
            <TextBlock Style="{StaticResource PulseDisplay}" Margin="0,2,0,0" Text="Pulse nasıl davransın?" />
            <TextBlock Style="{StaticResource PulseLead}" Margin="0,2,0,0" Text="Değişiklikler anında kaydedilir." />
            <Border Style="{StaticResource PulseHairline}" Margin="0,14,0,12" />

            <TextBlock Style="{StaticResource PulseLabel}" Text="OTOMATİK MOD" Margin="0,0,0,8" />
            <Border Style="{StaticResource PulseCard}" Padding="0">
                <StackPanel>
                    <Grid Margin="14,11">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingTitle}" Text="Oyun açılınca Oyun moduna geç" />
                            <TextBlock Style="{StaticResource PulseMuted}" Text="Oyunu kapatınca eski moduna döner. Sen elle bir mod seçtiysen ona karışmaz." />
                            <TextBlock Style="{StaticResource PulseMuted}" Text="{Binding GameText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoGameMode}" VerticalAlignment="Center" />
                    </Grid>
                    <Border Style="{StaticResource PulseHairline}" />
                    <Grid Margin="14,11">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingTitle}" Text="Fişi çekince Sessiz moda geç" />
                            <TextBlock Style="{StaticResource PulseMuted}" Text="Pilde daha az ısınır, fan daha az ses çıkarır, pil daha uzun gider." />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoQuietOnBattery}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource PulseLabel}" Text="ISI BEKÇİSİ" Margin="0,18,0,8" />
            <Border Style="{StaticResource PulseCard}" Padding="0">
                <Grid Margin="14,11">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Style="{StaticResource SettingTitle}" Text="Çok ısınırsa kendiliğinden serinlet" />
                        <TextBlock Style="{StaticResource PulseMuted}" TextWrapping="Wrap" Text="Bilgisayar tehlikeli derecede sıcak kalırsa (işlemci 97 °C, ekran kartı 90 °C üstünde, 10 saniye) önce haber verir, sonra Sessiz moda geçer. 1 dakika serin kalınca eski moduna döner. Kısa süreli ısınmalar (oyun yüklenirken) alarm vermez." />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding ThermalGuard}" VerticalAlignment="Center" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource PulseLabel}" Text="SOĞUTMA ÖNCELİĞİ" Margin="0,18,0,8" />
            <Border Style="{StaticResource PulseCard}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Style="{StaticResource SettingTitle}" Text="Önce soğut, sonra yavaşlat" />
                        <TextBlock Style="{StaticResource PulseMuted}" TextWrapping="Wrap"
                                   Text="Sıcaklık uzun süre yüksek kalırsa (88 °C üstü) önce fan desteği açılır (fan devri artar). Fan yetmezse (93 °C üstü) işlemci hızı küçük adımlarla düşürülür; serinleyince eski haline döner. Oyun modunda işlemciyi kısmaz, yalnız fanı destekler. Fan desteği şu an yalnızca ASUS dizüstülerde var. İşlemci sıcaklığı için Pulse yönetici olarak çalışmalı." />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding CoolingFirst}" />
                </Grid>
            </Border>

            <TextBlock Style="{StaticResource PulseLabel}" Text="SICAKLIK SINIRI" Margin="0,18,0,8" />
            <Border Style="{StaticResource PulseCard}" Padding="16,12">
                <StackPanel>
                    <TextBlock Style="{StaticResource SettingTitle}" Text="Bilgisayarı şu sıcaklığın altında tutmaya çalış" />
                    <ItemsControl ItemsSource="{Binding HeatChoices}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,6,0">
                                    <Button Content="{Binding Title}" Style="{StaticResource PulseSegment}" MinWidth="72"
                                            Command="{Binding DataContext.SetHeatCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    <Button Content="{Binding Title}" Style="{StaticResource PulseSegmentActive}" MinWidth="72" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.SetHeatCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource PulseMuted}" TextWrapping="Wrap" Text="{Binding HeatText}" Margin="0,8,0,0" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource PulseLabel}" Text="OTOMATİK TEMİZLİK" Margin="0,18,0,8" />
            <Border Style="{StaticResource PulseCard}" Padding="0">
                <Grid Margin="14,11">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Style="{StaticResource SettingTitle}" Text="Haftada bir gereksiz dosyaları kendiliğinden sil" />
                        <TextBlock Style="{StaticResource PulseMuted}" Text="Yalnızca 2 günden eski geçici dosyalar ve eski hata raporları. Belgelerine, oyunlarına, indirdiklerine ve geri dönüşüm kutusuna dokunmaz." />
                        <TextBlock Style="{StaticResource PulseMuted}" Text="{Binding AutoCleanText}" Margin="0,2,0,0" />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoClean}" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <TextBlock Style="{StaticResource PulseLabel}" Text="BAŞKA PROGRAMLARLA ÇAKIŞMA" Margin="0,18,0,8" />
            <Border Style="{StaticResource PulseCard}" Padding="0" Margin="0,0,0,8">
                <Grid Margin="14,11">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Style="{StaticResource SettingTitle}" Text="Başka bir program ayarı bozarsa düzelt" />
                        <TextBlock Style="{StaticResource PulseMuted}" TextWrapping="Wrap" Text="G-Helper, Armoury Crate gibi programlar güç ayarını değiştirirse Pulse bunu dakikada bir kontrol eder ve seçtiğin modun ayarını geri yazar. Bu sayede başka bir programı açık unutsan bile Oyun modun bozulmaz." />
                    </StackPanel>
                    <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding KeepMode}" VerticalAlignment="Center" />
                </Grid>
            </Border>
            <Border Style="{StaticResource PulseCard}" Padding="0">
                <StackPanel>
                    <Grid Margin="14,11">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingTitle}" Text="Mod seçerken G-Helper ve Armoury Crate açıksa kapat" />
                            <TextBlock Style="{StaticResource PulseMuted}" Text="İkisi de kendi ayarını uygulayıp senin seçtiğin modu bozabilir. Birini kullanmıyorsan bunu açık tut." />
                            <TextBlock Style="{StaticResource PulseMuted}" Text="{Binding ConflictsText}" Margin="0,2,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="Şimdi kapat" Style="{StaticResource PulseGhostButton}" Command="{Binding CloseConflictsCommand}" Margin="0,0,12,0" />
                            <ui:ToggleSwitch IsChecked="{Binding CloseConflictingApps}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource PulseLabel}" Text="UYGULAMA" Margin="0,18,0,8" />
            <Border Style="{StaticResource PulseCard}" Padding="0">
                <StackPanel>
                    <Grid Margin="14,11">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingTitle}" Text="Bilgisayar açılınca Pulse de açılsın" />
                            <TextBlock Style="{StaticResource PulseMuted}" Text="Pencere açmadan, sağ alttaki simge olarak başlar. İzin de sormaz." />
                            <TextBlock Style="{StaticResource PulseMuted}" Text="{Binding StartupMessage}" Margin="0,2,0,0" />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding StartWithWindows}" VerticalAlignment="Center" />
                    </Grid>
                    <Border Style="{StaticResource PulseHairline}" />
                    <Grid Margin="14,11">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource SettingTitle}" Text="Pencereyi kapatınca Pulse arka planda çalışmaya devam etsin" />
                            <TextBlock Style="{StaticResource PulseMuted}" Text="Kapalıysa pencereyi kapatmak Pulse'ı tamamen kapatır." />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTray}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource PulseLabel}" Text="GÖRÜNÜM VE BİLDİRİMLER" Margin="0,18,0,8" />
            <Border Style="{StaticResource PulseCard}" Padding="16,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource PulseBody}" FontWeight="Medium" Text="Oyun açılınca FPS ve ısı göstergesini kendiliğinden aç" />
                            <TextBlock Style="{StaticResource PulseMuted}" TextWrapping="Wrap"
                                       Text="Oyun kapanınca kendiliğinden kapanır. Görünmüyorsa oyunun görüntü ayarında “Tam ekran” yerine “Kenarlıksız pencere” seç." />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding AutoOverlay}" />
                    </Grid>
                    <Border Style="{StaticResource PulseHairline}" Margin="0,12,0,10" />
                    <TextBlock Style="{StaticResource SettingTitle}" Text="Bildirimler ekranın hangi köşesinde çıksın" />
                    <ItemsControl ItemsSource="{Binding NoticeCorners}" Margin="0,8,0,0">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,6,0">
                                    <Button Content="{Binding Title}" Style="{StaticResource PulseSegment}" MinWidth="84"
                                            Command="{Binding DataContext.SetNoticeCornerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    <Button Content="{Binding Title}" Style="{StaticResource PulseSegmentActive}" MinWidth="84" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.SetNoticeCornerCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource PulseMuted}" TextWrapping="Wrap" Margin="0,8,0,0"
                               Text="Oyun içindeki uyarılar tıklamayı geçirir, oyuna karışmaz. Oyun bittikten sonra çıkan bildirimlere (rapor, yeni sürüm) tıklayınca ilgili sayfa açılır." />
                    <Border Style="{StaticResource PulseHairline}" Margin="0,12,0,10" />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Turu göster" Style="{StaticResource PulseGhostButton}" Command="{Binding ShowTourCommand}" Margin="0,0,8,0" />
                            <Button Content="Ayar klasörünü aç" Style="{StaticResource PulseGhostButton}" Command="{Binding OpenDataFolderCommand}" />
                        </StackPanel>
                        <TextBlock Style="{StaticResource PulseMuted}" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Text="Ayarların güncellemede silinmez; her kayıtta otomatik yedeği alınır." />
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource PulseLabel}" Text="GÜNCELLEMELER" Margin="0,18,0,8" />
            <Border Style="{StaticResource PulseCard}" Padding="16,12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,20,0">
                            <TextBlock Style="{StaticResource PulseBody}" FontWeight="Medium" Text="Yeni sürüm var mı diye kendiliğinden bak" />
                            <TextBlock Style="{StaticResource PulseMuted}" TextWrapping="Wrap"
                                       Text="Günde en fazla bir kez GitHub'a bağlanıp en son sürüm numarasını sorar. Hiçbir şey indirmez ya da kurmaz, kişisel bilgi göndermez. Kapatırsan hiç bağlanmaz." />
                        </StackPanel>
                        <ui:ToggleSwitch Grid.Column="1" VerticalAlignment="Center" IsChecked="{Binding CheckUpdates}" />
                    </Grid>
                    <Border Style="{StaticResource PulseHairline}" Margin="0,10,0,10" />
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Şimdi denetle" Style="{StaticResource PulseGhostButton}" Command="{Binding CheckUpdateNowCommand}" Margin="0,0,8,0" />
                            <Button Content="Sürüm sayfasını aç" Style="{StaticResource PulseGhostButton}" Command="{Binding OpenReleasePageCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding UpdateStatus}" Style="{StaticResource PulseMuted}" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                    </DockPanel>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource PulseLabel}" Text="DİL / LANGUAGE" Margin="0,18,0,8" />
            <Border Style="{StaticResource PulseCard}" Padding="16,12">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Languages}">
                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,6,0">
                                    <Button Content="{Binding Title}" Style="{StaticResource PulseSegment}" MinWidth="120"
                                            Command="{Binding DataContext.SetLanguageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                    <Button Content="{Binding Title}" Style="{StaticResource PulseSegmentActive}" MinWidth="120" Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.SetLanguageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource PulseMuted}" TextWrapping="Wrap" Margin="0,8,0,0" Text="{Binding LanguageNote}" />
                </StackPanel>
            </Border>

            <TextBlock Style="{StaticResource PulseLabel}" Text="DESTEK" Margin="0,18,0,8" />
            <Border Style="{StaticResource PulseCard}" Padding="16,12">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Bir kahve ısmarla ☕" Style="{StaticResource PulseGhostButton}" Command="{Binding OpenSupportPageCommand}" VerticalAlignment="Center" />
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Style="{StaticResource PulseBody}" FontWeight="Medium" Text="KLYC-Pulse ücretsiz ve açık kaynak" />
                        <TextBlock Style="{StaticResource PulseMuted}" TextWrapping="Wrap"
                                   Text="İşine yaradıysa bir kahve ısmarlayarak geliştirmeye destek olabilirsin. Zorunlu değil; hiçbir özellik buna bağlı değil." />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Style="{StaticResource PulseHairline}" Margin="0,22,0,10" />
            <TextBlock Style="{StaticResource PulseMuted}" Text="{Binding VersionText}" />
            <TextBlock Style="{StaticResource PulseMuted}" Margin="0,2,0,0" TextWrapping="Wrap"
                       Text="Donanım ayarlarını değiştirir; kendi sorumluluğunda kullan. Sorun olursa Kendini sınama kısayoluyla sonuç dosyası alabilirsin." />
        </StackPanel>
    </ScrollViewer>
</Page>