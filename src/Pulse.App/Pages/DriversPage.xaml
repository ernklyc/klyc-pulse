<Page x:Class="Pulse.App.Pages.DriversPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:c="clr-namespace:Pulse.App.Controls"
      Background="Transparent" FontFamily="{StaticResource BodyFont}"
      ScrollViewer.CanContentScroll="False" ScrollViewer.VerticalScrollBarVisibility="Disabled">
    <Page.Resources>
        <DataTemplate x:Key="RowTemplate">
            <StackPanel>
                <Grid Margin="16,9">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource PulseBadge}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,1,0,0">
                        <TextBlock Text="{Binding Label}" Foreground="{Binding Brush}" FontSize="10.5" FontWeight="SemiBold" />
                    </Border>
                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" Style="{StaticResource PulseBody}" FontWeight="Medium" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Detail}" Style="{StaticResource PulseMuted}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
                <Border Style="{StaticResource PulseHairline}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,18,26,22" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource PulseLabel}" Text="SÜRÜCÜLER" />
            <TextBlock Style="{StaticResource PulseDisplay}" Margin="0,2,0,0" Text="Güncel mi, eski mi?" />
            <TextBlock Style="{StaticResource PulseLead}" Margin="0,2,0,0"
                       Text="BIOS ve sürücülerin sürümleri. Taramak hiçbir şey indirmez, kurmak her zaman senin kararın." />
            <Border Style="{StaticResource PulseHairline}" Margin="0,14,0,12" />

            <Border Style="{StaticResource PulseCard}" Padding="16,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="NVIDIA App" Style="{StaticResource PulseGhostButton}" Command="{Binding OpenNvidiaAppCommand}" Margin="0,0,8,0"
                                Visibility="{Binding HasNvidiaApp, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PulseLabel}" Text="BIOS VE EKRAN KARTI" />
                        <TextBlock Text="{Binding BiosText}" FontFamily="{StaticResource DisplayFont}" FontSize="22" Foreground="{StaticResource InkBrush}" />
                        <TextBlock Style="{StaticResource PulseMuted}" Text="{Binding BiosNote}" TextWrapping="Wrap" />
                        <TextBlock Style="{StaticResource PulseMuted}" Text="{Binding NvidiaText}" Margin="0,2,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <TextBlock Style="{StaticResource PulseLabel}" Text="YENİ SÜRÜCÜ VAR MI?" Margin="0,16,0,8" />
            <Border Style="{StaticResource PulseCard}" Padding="16,12">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Windows Update'i aç" Style="{StaticResource PulseGhostButton}" Command="{Binding OpenWindowsUpdateCommand}" Margin="0,0,8,0" />
                        <Button Content="Windows Update'te ara" Style="{StaticResource PulsePrimaryButton}" Command="{Binding SearchCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" />
                    </StackPanel>
                    <TextBlock Text="{Binding UpdateNote}" Style="{StaticResource PulseBody}" FontWeight="Medium" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,16,0" />
                </DockPanel>
            </Border>
            <Border Style="{StaticResource PulseCard}" Padding="16,12" Margin="0,8,0,0" Visibility="{Binding Op.IsActive, Converter={StaticResource BoolToVis}}">
                <c:BusyBar IsActive="{Binding Op.IsActive}" Fraction="{Binding Op.Fraction}" Text="{Binding Op.Text}" Counter="{Binding Op.Counter}" />
            </Border>
            <Border Style="{StaticResource PulseCard}" Padding="0" Margin="0,8,0,0">
                <ItemsControl ItemsSource="{Binding Updates}" ItemTemplate="{StaticResource RowTemplate}" />
            </Border>

            <TextBlock Style="{StaticResource PulseLabel}" Text="KURULU SÜRÜCÜLER" Margin="0,16,0,8" />
            <Border Style="{StaticResource PulseCard}" Padding="0">
                <ItemsControl ItemsSource="{Binding Installed}" ItemTemplate="{StaticResource RowTemplate}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>