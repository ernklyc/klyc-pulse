<Page x:Class="Pulse.App.Pages.CleanupPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:c="clr-namespace:Pulse.App.Controls"
      Background="Transparent" FontFamily="{StaticResource BodyFont}"
      ScrollViewer.CanContentScroll="False" ScrollViewer.VerticalScrollBarVisibility="Disabled">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,18,26,22" MaxWidth="1000" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource PulseLabel}" Text="TEMİZLİK" />
            <TextBlock Style="{StaticResource PulseDisplay}" Margin="0,2,0,0" Text="Gereksizi bul, güvenle temizle." />
            <TextBlock Style="{StaticResource PulseLead}" Margin="0,2,0,0"
                       Text="Yalnızca zaten yeniden oluşan dosyalar silinir. Biraz riskli olanlar silinmeden önce 7 gün ayrı bir yerde bekler, pişman olursan geri alırsın." />
            <Border Style="{StaticResource PulseHairline}" Margin="0,14,0,12" />

            <!-- Özet + eylemler -->
            <Border Style="{StaticResource PulseCard}" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Style="{StaticResource PulseLabel}" Text="{Binding TotalNote}" />
                        <TextBlock Style="{StaticResource PulseStat}" Text="{Binding TotalText}" FontSize="34" />
                        <TextBlock Style="{StaticResource PulseMuted}" Text="{Binding Status}" Margin="0,2,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="Tara" Style="{StaticResource PulseGhostButton}" Command="{Binding ScanCommand}" Margin="0,0,8,0" Width="80"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" />
                        <Button Content="Seçilenleri temizle" Style="{StaticResource PulsePrimaryButton}" Command="{Binding CleanCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" />
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource PulseCard}" Padding="16,12" Margin="0,8,0,0"
                    Visibility="{Binding Op.IsActive, Converter={StaticResource BoolToVis}}">
                <c:BusyBar IsActive="{Binding Op.IsActive}" Fraction="{Binding Op.Fraction}" Text="{Binding Op.Text}" Counter="{Binding Op.Counter}" />
            </Border>

            <!-- Kategoriler -->
            <TextBlock Style="{StaticResource PulseLabel}" Text="KATEGORİLER" Margin="0,16,0,8" />
            <Border Style="{StaticResource PulseCard}" Padding="0">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid Margin="14,9" x:Name="Row">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding Unavailable, Converter={StaticResource InvertBool}}"
                                              VerticalAlignment="Top" MinWidth="0" Margin="0,2,10,0" />
                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource PulseBody}" FontWeight="Medium" />
                                            <Border Style="{StaticResource PulseBadge}" Margin="8,0,0,0" VerticalAlignment="Center"
                                                    Visibility="{Binding Badge, Converter={StaticResource StringToVis}}">
                                                <TextBlock Text="{Binding Badge}" FontSize="10.5" Foreground="{StaticResource AccentGrayBrush}" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Description}" Style="{StaticResource PulseMuted}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource PulseBody}" FontWeight="Medium"
                                               VerticalAlignment="Top" TextAlignment="Right" MinWidth="90" />
                                </Grid>
                                <Border Style="{StaticResource PulseHairline}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>

            <!-- Karantina -->
            <Border Style="{StaticResource PulseCard}" Margin="0,12,0,0" Padding="14,10">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Hepsini geri getir" Style="{StaticResource PulseGhostButton}" Command="{Binding RestoreQuarantineCommand}" />
                    <TextBlock Text="{Binding QuarantineText}" Style="{StaticResource PulseMuted}" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- Eski kalıntılar -->
            <DockPanel Margin="0,18,0,8">
                <Button DockPanel.Dock="Right" Content="Kalıntıları bul" Style="{StaticResource PulseGhostButton}" Command="{Binding FindOrphansCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" />
                <TextBlock Style="{StaticResource PulseLabel}" Text="ESKİ KALINTILAR" VerticalAlignment="Center" />
            </DockPanel>
            <Border Style="{StaticResource PulseCard}" Padding="0">
                <StackPanel>
                    <TextBlock Text="{Binding OrphanNote}" Style="{StaticResource PulseMuted}" TextWrapping="Wrap" Margin="14,10" />
                    <ItemsControl ItemsSource="{Binding Orphans}" Visibility="{Binding HasOrphans, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Style="{StaticResource PulseHairline}" />
                                    <Grid Margin="14,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="80" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Top" MinWidth="0" Margin="0,2,10,0" />
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource PulseBody}" FontWeight="Medium" />
                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource PulseMuted}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <TextBlock Grid.Column="2" Text="{Binding SizeText}" Style="{StaticResource PulseBody}" FontWeight="SemiBold" VerticalAlignment="Center" TextAlignment="Right" Margin="0,0,10,0" />
                                        <Button Grid.Column="3" Content="Aç" Style="{StaticResource PulseGhostButton}" MinWidth="50" Height="26" VerticalAlignment="Center"
                                                Command="{Binding DataContext.OpenOrphanCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource PulseHairline}" Visibility="{Binding HasOrphans, Converter={StaticResource BoolToVis}}" />
                    <Button Content="Seçilenleri Geri Dönüşüm Kutusu'na gönder" Style="{StaticResource PulseGhostButton}" Margin="14,10" HorizontalAlignment="Left"
                            Visibility="{Binding HasOrphans, Converter={StaticResource BoolToVis}}"
                            Command="{Binding RemoveOrphansCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" />
                </StackPanel>
            </Border>

            <!-- Kopya dosyalar -->
            <DockPanel Margin="0,18,0,8">
                <Button DockPanel.Dock="Right" Content="Kopyaları bul" Style="{StaticResource PulseGhostButton}" Command="{Binding FindDuplicatesCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" />
                <TextBlock Style="{StaticResource PulseLabel}" Text="KOPYA DOSYALAR" VerticalAlignment="Center" />
            </DockPanel>
            <Border Style="{StaticResource PulseCard}" Padding="0">
                <StackPanel>
                    <TextBlock Text="{Binding DupNote}" Style="{StaticResource PulseMuted}" TextWrapping="Wrap" Margin="14,10" />
                    <ItemsControl ItemsSource="{Binding DupGroups}" Visibility="{Binding HasDups, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Style="{StaticResource PulseHairline}" />
                                    <StackPanel Margin="14,8,14,6">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource PulseBody}" FontWeight="Medium" />
                                        <TextBlock Text="{Binding Header}" Style="{StaticResource PulseMuted}" />
                                        <ItemsControl ItemsSource="{Binding Files}" Margin="0,4,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2">
                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                        <CheckBox IsChecked="{Binding IsSelected}" IsEnabled="{Binding CanSelect}" MinWidth="0" Margin="0,0,10,0" VerticalAlignment="Top" />
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Path}" Style="{StaticResource PulseMuted}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Text="{Binding Detail}" Style="{StaticResource PulseMuted}" FontSize="11" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Border Style="{StaticResource PulseHairline}" Visibility="{Binding HasDups, Converter={StaticResource BoolToVis}}" />
                    <StackPanel Orientation="Horizontal" Margin="14,10" Visibility="{Binding HasDups, Converter={StaticResource BoolToVis}}">
                        <Button Content="Fazlalıkları seç" Style="{StaticResource PulseGhostButton}" Command="{Binding SelectDupExtrasCommand}" Margin="0,0,8,0" />
                        <Button Content="Seçilenleri Geri Dönüşüm Kutusu'na gönder" Style="{StaticResource PulseGhostButton}" Command="{Binding RemoveDuplicatesCommand}"
                                IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Geri Yükleme Noktaları -->
            <TextBlock Style="{StaticResource PulseLabel}" Text="GERİ YÜKLEME NOKTALARI" Margin="0,18,0,8" />
            <Border Style="{StaticResource PulseCard}" Padding="0">
                <StackPanel>
                    <DockPanel Margin="14,10">
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <Button Content="Yenile" Style="{StaticResource PulseGhostButton}" Command="{Binding LoadRestorePointsCommand}" Margin="0,0,8,0" MinWidth="64" />
                            <Button Content="Windows'ta aç" Style="{StaticResource PulseGhostButton}" Command="{Binding OpenSystemRestoreCommand}" />
                        </StackPanel>
                        <TextBlock Text="{Binding RestoreNote}" Style="{StaticResource PulseMuted}" VerticalAlignment="Center" Margin="0,0,12,0" />
                    </DockPanel>
                    <ItemsControl ItemsSource="{Binding RestorePoints}" Visibility="{Binding HasRestorePoints, Converter={StaticResource BoolToVis}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <Border Style="{StaticResource PulseHairline}" />
                                    <Grid Margin="14,8">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="140" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DateText}" Style="{StaticResource PulseBody}" FontWeight="Medium" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" Style="{StaticResource PulseMuted}" TextTrimming="CharacterEllipsis" />
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource PulseMuted}" Margin="0,6,0,0" TextWrapping="Wrap"
                       Text="Bilgisayarı eski haline döndürmek için “Windows'ta aç”a bas. Windows'un kendi penceresi açılır, geri dönüşü orada sen başlatırsın." />
            <!-- Disk analizi -->
            <DockPanel Margin="0,18,0,8">
                <Button DockPanel.Dock="Right" Content="Disk analizi" Style="{StaticResource PulseGhostButton}" Command="{Binding AnalyzeCommand}" />
                <TextBlock Style="{StaticResource PulseLabel}" Text="DİSKİ NE DOLDURUYOR" VerticalAlignment="Center" />
            </DockPanel>
            <Border Style="{StaticResource PulseCard}" Padding="0" Visibility="{Binding HasFolders, Converter={StaticResource BoolToVis}}">
                <ItemsControl ItemsSource="{Binding Folders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <Grid Margin="14,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="90" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SizeText}" Style="{StaticResource PulseBody}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding Path}" Style="{StaticResource PulseMuted}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding DateText}" Style="{StaticResource PulseMuted}" VerticalAlignment="Center" />
                                    <Button Grid.Column="3" Content="Aç" Style="{StaticResource PulseGhostButton}" MinWidth="50" Height="26"
                                            Command="{Binding DataContext.OpenFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                                <Border Style="{StaticResource PulseHairline}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>